(
    schema_hash: "0a01a6e287f33bd4279ee8403dcb0b89645ec6fbbe251bf2ffdc4491a844bb2f",
    kinds: [
        (
            name: "charter",
            doc: "The KB's charter — WHY this knowledge base exists. One record, written
early and kept current: every curation judgement should be defensible
against it. When the KB's purpose shifts, propose a charter update in the
same breath as the work that shifts it.",
            storage: "facts/charter.ron",
            fields: [
                (
                    name: "purpose",
                    doc: "One-line statement of what this KB is for.",
                    ty: Str,
                    role: Some("title"),
                ),
                (
                    name: "objectives",
                    doc: r#"The concrete objectives — what "done" looks like, each independently
checkable. Keep them few and honest."#,
                    ty: List(Markdown),
                ),
                (
                    name: "notes",
                    doc: "Scope, period under review, ground rules, exclusions (Markdown prose).",
                    ty: Markdown,
                ),
            ],
        ),
        (
            name: "entity",
            doc: "A person or organisation — the **entity** primitive (`aliases`, `email`,
`location`, `role`). The most enriched page type: an entity page is a
briefing, not a contact card. Typed edges to other pages live on
[`Relationship`]; claims about it live on [`Take`].",
            storage: "facts/entities/{id}.ron",
            fields: [
                (
                    name: "id",
                    doc: "Canonical slug — the stable identity (`jane-doe`, `acme`); matches the
filename. Disambiguate collisions (`david-liu-meta`).",
                    ty: Str,
                ),
                (
                    name: "title",
                    doc: "Display name.",
                    ty: Str,
                    role: Some("title"),
                ),
                (
                    name: "type",
                    doc: "Which entity page type this is.",
                    ty: Enum([
                        (
                            name: "Person",
                        ),
                        (
                            name: "Company",
                        ),
                    ]),
                ),
                (
                    name: "subtype",
                    doc: "Finer class within the type, when it has one (company →
`company`/`product`/`org`). Free-form, matching gbrain's frontmatter.",
                    ty: Option(Str),
                ),
                (
                    name: "aliases",
                    doc: "Every known name variant — misspellings, maiden names, nicknames, email
addresses, social handles. Dedup reads this; it never forks a new page
for a name already listed here.",
                    ty: List(Str),
                ),
                (
                    name: "email",
                    doc: "Primary email address.",
                    ty: Option(Str),
                ),
                (
                    name: "location",
                    doc: "Where they are — city, region.",
                    ty: Option(Str),
                ),
                (
                    name: "role",
                    doc: "Current role/title (person) or one-line what-they-do (company).",
                    ty: Option(Str),
                ),
                (
                    name: "compiled",
                    doc: "Compiled truth — the always-current synthesis, rewritten when evidence
changes. Read only this and you know the state of play.",
                    ty: Markdown,
                ),
                (
                    name: "timeline",
                    doc: "Timeline — append-only, dated evidence entries; never rewritten.",
                    ty: List(Struct([
                        (
                            name: "time",
                            doc: "When it happened.",
                            ty: Date,
                        ),
                        (
                            name: "entry",
                            doc: "What happened — a dated, sourced note (Markdown prose).",
                            ty: Markdown,
                        ),
                    ])),
                ),
            ],
        ),
        (
            name: "media",
            doc: "An artifact — an article, video, tweet, essay, source document, or analysis
(the **media** primitive: `url`, `source`, `author`, `date`).",
            storage: "facts/media/{id}.ron",
            fields: [
                (
                    name: "id",
                    doc: "Canonical slug; matches the filename.",
                    ty: Str,
                ),
                (
                    name: "title",
                    doc: "Display title.",
                    ty: Str,
                    role: Some("title"),
                ),
                (
                    name: "type",
                    doc: "Which media page type this is.",
                    ty: Enum([
                        (
                            name: "Media",
                        ),
                        (
                            name: "Tweet",
                        ),
                        (
                            name: "Analysis",
                        ),
                        (
                            name: "Source",
                        ),
                        (
                            name: "Writing",
                        ),
                    ]),
                ),
                (
                    name: "subtype",
                    doc: "Finer class within the type (media → `video`/`article`/`essay`/`book`/
`podcast`/`blog`; tweet → `single`/`bundle`/`stub`).",
                    ty: Option(Str),
                ),
                (
                    name: "url",
                    doc: "Canonical URL of the artifact.",
                    ty: Option(Str),
                ),
                (
                    name: "source",
                    doc: "Where it came from — publication, platform, feed.",
                    ty: Option(Str),
                ),
                (
                    name: "author",
                    doc: "Author/creator, as named at the source.",
                    ty: Option(Str),
                ),
                (
                    name: "date",
                    doc: "Publication/creation date.",
                    ty: Option(Date),
                    role: Some("date"),
                ),
                (
                    name: "compiled",
                    doc: "Compiled truth — the always-current synthesis.",
                    ty: Markdown,
                ),
                (
                    name: "timeline",
                    doc: "Timeline — append-only, dated evidence entries; never rewritten.",
                    ty: List(Struct([
                        (
                            name: "time",
                            doc: "When it happened.",
                            ty: Date,
                        ),
                        (
                            name: "entry",
                            doc: "What happened — a dated, sourced note (Markdown prose).",
                            ty: Markdown,
                        ),
                    ])),
                ),
            ],
        ),
        (
            name: "temporal",
            doc: "A dated event or exchange — a deal, email, Slack thread, calendar event,
diary entry, or social digest (the **temporal** primitive: `date`,
`attendees`, `duration`, `location`).",
            storage: "facts/temporal/{id}.ron",
            fields: [
                (
                    name: "id",
                    doc: "Canonical slug; matches the filename.",
                    ty: Str,
                ),
                (
                    name: "title",
                    doc: "Display title.",
                    ty: Str,
                    role: Some("title"),
                ),
                (
                    name: "type",
                    doc: "Which temporal page type this is.",
                    ty: Enum([
                        (
                            name: "SocialDigest",
                        ),
                        (
                            name: "Deal",
                        ),
                        (
                            name: "Email",
                        ),
                        (
                            name: "Slack",
                        ),
                        (
                            name: "Event",
                        ),
                        (
                            name: "Diary",
                        ),
                    ]),
                ),
                (
                    name: "subtype",
                    doc: "Finer class within the type (social-digest → `daily`/`monthly`).",
                    ty: Option(Str),
                ),
                (
                    name: "date",
                    doc: "When it happened.",
                    ty: Option(Date),
                    role: Some("date"),
                ),
                (
                    name: "attendees",
                    doc: "Entities present or involved — typed links to `entity` pages.",
                    ty: List(Link(
                        allowed: Some([
                            "entity",
                        ]),
                    )),
                ),
                (
                    name: "duration",
                    doc: "How long it ran (free-form, e.g. `45m`).",
                    ty: Option(Str),
                ),
                (
                    name: "location",
                    doc: "Where it happened.",
                    ty: Option(Str),
                ),
                (
                    name: "compiled",
                    doc: "Compiled truth — your analysis, not a transcript dump.",
                    ty: Markdown,
                ),
                (
                    name: "timeline",
                    doc: "Timeline — append-only, dated evidence entries; never rewritten.",
                    ty: List(Struct([
                        (
                            name: "time",
                            doc: "When it happened.",
                            ty: Date,
                        ),
                        (
                            name: "entry",
                            doc: "What happened — a dated, sourced note (Markdown prose).",
                            ty: Markdown,
                        ),
                    ])),
                ),
            ],
        ),
        (
            name: "annotation",
            doc: "An atom — a small, provenance-bearing unit of extracted knowledge (the
**annotation** primitive: `confidence`, `valid_from`, `source`).",
            storage: "facts/atoms/{id}.ron",
            fields: [
                (
                    name: "id",
                    doc: "Canonical slug; matches the filename.",
                    ty: Str,
                ),
                (
                    name: "title",
                    doc: "Display title.",
                    ty: Str,
                    role: Some("title"),
                ),
                (
                    name: "type",
                    doc: "Which annotation page type this is.",
                    ty: Enum([
                        (
                            name: "Atom",
                        ),
                    ]),
                ),
                (
                    name: "subtype",
                    doc: "Finer class within the type (atom → `extraction`/`manual`/`lore`,
gbrain's `origin`).",
                    ty: Option(Str),
                ),
                (
                    name: "confidence",
                    doc: "How much to trust this — `high`/`medium`/`low` or a note.",
                    ty: Option(Str),
                ),
                (
                    name: "valid_from",
                    doc: "When the claim started being true.",
                    ty: Option(Date),
                    role: Some("date"),
                ),
                (
                    name: "source",
                    doc: "Where the atom came from.",
                    ty: Option(Str),
                ),
                (
                    name: "compiled",
                    doc: "Compiled truth — the always-current synthesis.",
                    ty: Markdown,
                ),
                (
                    name: "timeline",
                    doc: "Timeline — append-only, dated evidence entries; never rewritten.",
                    ty: List(Struct([
                        (
                            name: "time",
                            doc: "When it happened.",
                            ty: Date,
                        ),
                        (
                            name: "entry",
                            doc: "What happened — a dated, sourced note (Markdown prose).",
                            ty: Markdown,
                        ),
                    ])),
                ),
            ],
        ),
        (
            name: "concept",
            doc: "A concept, project, or note (the **concept** primitive: `tags`). Concept =
a framework you could teach; project = something being actively built;
note = the catch-all for anything not otherwise typed.",
            storage: "facts/concepts/{id}.ron",
            fields: [
                (
                    name: "id",
                    doc: "Canonical slug; matches the filename.",
                    ty: Str,
                ),
                (
                    name: "title",
                    doc: "Display title.",
                    ty: Str,
                    role: Some("title"),
                ),
                (
                    name: "type",
                    doc: "Which concept page type this is.",
                    ty: Enum([
                        (
                            name: "Concept",
                        ),
                        (
                            name: "Project",
                        ),
                        (
                            name: "Note",
                        ),
                    ]),
                ),
                (
                    name: "subtype",
                    doc: "Finer class within the type, when it has one.",
                    ty: Option(Str),
                ),
                (
                    name: "tags",
                    doc: "Free-form tags for grouping and retrieval.",
                    ty: List(Str),
                ),
                (
                    name: "compiled",
                    doc: "Compiled truth — the always-current synthesis.",
                    ty: Markdown,
                ),
                (
                    name: "timeline",
                    doc: "Timeline — append-only, dated evidence entries; never rewritten.",
                    ty: List(Struct([
                        (
                            name: "time",
                            doc: "When it happened.",
                            ty: Date,
                        ),
                        (
                            name: "entry",
                            doc: "What happened — a dated, sourced note (Markdown prose).",
                            ty: Markdown,
                        ),
                    ])),
                ),
            ],
        ),
        (
            name: "relationship",
            doc: "A typed edge between two pages — gbrain's link graph as first-class records.
A kyyn `Link` carries no verb, so the edge itself is a kind: it names the
two endpoints and the [`LinkVerb`] between them.",
            storage: "facts/relationships/{id}.ron",
            fields: [
                (
                    name: "id",
                    doc: "Canonical slug; matches the filename (e.g. `jane-doe-works-at-acme`).",
                    ty: Str,
                ),
                (
                    name: "title",
                    doc: r#"Human-readable label, e.g. "Jane Doe works_at Acme"."#,
                    ty: Str,
                    role: Some("title"),
                ),
                (
                    name: "from",
                    doc: "Source page of the edge.",
                    ty: Link(
                        allowed: Some([
                            "entity",
                            "media",
                            "temporal",
                            "annotation",
                            "concept",
                        ]),
                    ),
                ),
                (
                    name: "to",
                    doc: "Target page of the edge.",
                    ty: Link(
                        allowed: Some([
                            "entity",
                            "media",
                            "temporal",
                            "annotation",
                            "concept",
                        ]),
                    ),
                ),
                (
                    name: "verb",
                    doc: "The relationship verb.",
                    ty: Enum([
                        (
                            name: "PartnerOf",
                        ),
                        (
                            name: "RelatesTo",
                        ),
                        (
                            name: "Mentions",
                        ),
                        (
                            name: "Discusses",
                        ),
                        (
                            name: "Founded",
                        ),
                        (
                            name: "WorksAt",
                        ),
                        (
                            name: "InvestedIn",
                        ),
                        (
                            name: "SourcedFrom",
                        ),
                        (
                            name: "DerivedFrom",
                        ),
                        (
                            name: "Supersedes",
                        ),
                        (
                            name: "RedirectsTo",
                        ),
                        (
                            name: "Attended",
                        ),
                        (
                            name: "Authored",
                        ),
                        (
                            name: "AttributedTo",
                        ),
                    ]),
                ),
                (
                    name: "context",
                    doc: "Why this edge exists / supporting context (Markdown prose).",
                    ty: Markdown,
                ),
            ],
        ),
        (
            name: "take",
            doc: r#"A structured claim about a page — gbrain's "takes" (fact / take / bet /
hunch), with provenance. Contradictions become data, not bugs: two takes on
the same subject with different values sit side by side."#,
            storage: "facts/takes/{id}.ron",
            fields: [
                (
                    name: "id",
                    doc: "Canonical slug; matches the filename.",
                    ty: Str,
                ),
                (
                    name: "title",
                    doc: "Short label for the claim.",
                    ty: Str,
                    role: Some("title"),
                ),
                (
                    name: "subject",
                    doc: "The page this claim is about.",
                    ty: Link(
                        allowed: Some([
                            "entity",
                            "media",
                            "temporal",
                            "annotation",
                            "concept",
                        ]),
                    ),
                ),
                (
                    name: "kind",
                    doc: "What sort of claim this is.",
                    ty: Enum([
                        (
                            name: "Fact",
                            doc: "An established, verifiable fact.",
                        ),
                        (
                            name: "Take",
                            doc: "A judgement or opinion.",
                        ),
                        (
                            name: "Bet",
                            doc: "A prediction about the future.",
                        ),
                        (
                            name: "Hunch",
                            doc: "A low-confidence guess.",
                        ),
                    ]),
                ),
                (
                    name: "claim",
                    doc: "The claim itself (Markdown prose).",
                    ty: Markdown,
                ),
                (
                    name: "confidence",
                    doc: "Confidence — `high`/`medium`/`low` or a note.",
                    ty: Option(Str),
                ),
                (
                    name: "valid_from",
                    doc: "When the claim started being true.",
                    ty: Option(Date),
                    role: Some("date"),
                ),
                (
                    name: "source",
                    doc: "Where the claim came from.",
                    ty: Option(Str),
                ),
            ],
        ),
    ],
    roles: [
        (
            name: "title",
            doc: "Names the record — lists, links, briefs.",
            binds: Title,
        ),
        (
            name: "date",
            doc: "Places the record on the KB's timeline — sorting, recency.",
            binds: Timeline,
        ),
    ],
)
